<launch>
  <!--
    Dedicated static-map capture launcher.  Choose a new run_dir for every
    survey: existing keyframe pose files deliberately refuse to be overwritten.
    This launcher keeps raw keyframes after shutdown so the offline builder can
    ray-cast from the real LiDAR origins.
  -->
  <arg name="rviz" default="false" />
  <arg name="img_en" default="1" />
  <arg name="run_dir" default="$(find fast_livo)/Log/nav_runs/change_this_run_id" />

  <rosparam command="load" file="$(find fast_livo)/config/robotdog.yaml" />
  <param name="/common/img_en" value="$(arg img_en)" type="int" />

  <param name="/pcd_save/output_dir" value="$(arg run_dir)/pcd" type="str" />
  <param name="/loop_closure/keyframe_save_en" value="true" type="bool" />
  <param name="/loop_closure/keyframe_dir" value="$(arg run_dir)/keyframes" type="str" />
  <param name="/loop_closure/keyframe_overwrite" value="false" type="bool" />
  <param name="/loop_backend/online_enable" value="true" type="bool" />
  <param name="/loop_backend/export_on_shutdown" value="true" type="bool" />
  <param name="/loop_backend/output_dir" value="$(arg run_dir)/loop_backend" type="str" />
  <param name="/loop_backend/output_overwrite" value="false" type="bool" />
  <param name="/dense_global_map/cache_dir" value="$(arg run_dir)/dense_rgb_cache" type="str" />
  <param name="/dense_global_map/output_path" value="$(arg run_dir)/pcd/all_global_optimized_rgb_dense_full.pcd" type="str" />
  <param name="/dense_global_map/cleanup_intermediate_on_success" value="false" type="bool" />

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_pinhole.yaml" />
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
