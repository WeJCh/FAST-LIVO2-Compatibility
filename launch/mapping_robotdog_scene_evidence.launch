<launch>
  <!--
    Offline, isolated replay configuration for road_map_product_v4 evidence.
    It preserves the normal LIO/VIO/loop math and changes only output paths
    plus the optional frame-provenance sidecar.
  -->
  <arg name="rviz" default="false"/>
  <arg name="img_en" default="1"/>
  <arg name="run_dir" default="/tmp/fast_livo_scene_evidence_run"/>

  <rosparam command="load" file="$(find fast_livo)/config/robotdog.yaml"/>
  <param name="/common/img_en" value="$(arg img_en)" type="int"/>

  <param name="/pcd_save/output_dir" value="$(arg run_dir)/pcd" type="str"/>
  <param name="/loop_closure/keyframe_dir" value="$(arg run_dir)/keyframes" type="str"/>
  <param name="/loop_closure/keyframe_overwrite" value="false" type="bool"/>
  <param name="/loop_backend/output_dir" value="$(arg run_dir)/loop_backend" type="str"/>
  <param name="/loop_backend/output_overwrite" value="false" type="bool"/>
  <param name="/dense_global_map/cache_dir" value="$(arg run_dir)/dense_rgb_cache" type="str"/>
  <param name="/dense_global_map/output_path"
         value="$(arg run_dir)/pcd/all_global_optimized_rgb_dense_full.pcd" type="str"/>
  <param name="/dense_global_map/cleanup_intermediate_on_success" value="false" type="bool"/>
  <param name="/scene_evidence_export/enabled" value="true" type="bool"/>
  <param name="/scene_evidence_export/output_dir" value="$(arg run_dir)/scene_evidence" type="str"/>
  <param name="/scene_evidence_export/overwrite" value="false" type="bool"/>

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_pinhole.yaml"/>
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz"/>
  </group>
</launch>
